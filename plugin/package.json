{
    "name": "zotero-pdf2zh-community",
    "version": "4.1.8",
    "description": "Unofficial community-maintained Zotero PDF translation: compatible APIs, managed dependencies, verified assets, and actionable diagnostics.",
    "config": {
        "addonName": "Zotero PDF2zh Community",
        "addonID": "pdf2zh-community@q1351998764.github.io",
        "addonRef": "pdf2zhcommunity",
        "addonInstance": "pdf2zhCommunity",
        "prefsPrefix": "extensions.zotero.pdf2zhcommunity"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Q1351998764/zotero-pdf2zh-community.git"
    },
    "author": "guaguastandup",
    "contributors": [
        "Q1351998764 (community maintenance)"
    ],
    "bugs": {
        "url": "https://github.com/Q1351998764/zotero-pdf2zh-community/issues"
    },
    "homepage": "https://github.com/Q1351998764/zotero-pdf2zh-community#readme",
    "license": "AGPL-3.0-or-later",
    "scripts": {
        "start": "zotero-plugin serve",
        "build": "tsc --noEmit && zotero-plugin build",
        "lint:check": "prettier --check . && eslint .",
        "lint:fix": "prettier --write . && eslint . --fix",
        "release": "zotero-plugin release",
        "test": "node --experimental-strip-types --test tests/*.test.mts",
        "update-deps": "npm update --save"
    },
    "dependencies": {
        "zotero-plugin-toolkit": "^5.1.0-beta.10"
    },
    "devDependencies": {
        "@eslint/js": "^9.22.0",
        "@types/node": "^22.13.10",
        "axios": "^1.8.2",
        "eslint": "^9.22.0",
        "form-data": "^4.0.2",
        "path": "^0.12.7",
        "prettier": "^3.5.3",
        "typescript": "^5.8.2",
        "typescript-eslint": "^8.26.0",
        "zotero-plugin-scaffold": "^0.3.2",
        "zotero-types": "^4.1.0-beta.4",
        "@napi-rs/canvas": "^0.1.80"
    },
    "prettier": {
        "printWidth": 80,
        "tabWidth": 4,
        "endOfLine": "lf",
        "overrides": [
            {
                "files": [
                    "*.xhtml"
                ],
                "options": {
                    "htmlWhitespaceSensitivity": "css"
                }
            }
        ]
    },
    "overrides": {
        "adm-zip": "0.6.1"
    }
}
